{
  "name": "marudesk",
  "private": true,
  "version": "0.2.0",
  "description": "Code-aware desktop agent with a browser stage, editor, and terminal.",
  "author": "Liruns",
  "homepage": "https://github.com/Liruns/marudesk",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac dmg",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:linux": "npm run build && electron-builder --linux",
    "publish:win": "npm run build && electron-builder --win nsis --publish always",
    "publish:mac": "npm run build && electron-builder --mac dmg --publish always",
    "publish:linux": "npm run build && electron-builder --linux --publish always",
    "lint": "eslint .",
    "rebuild:native": "electron-builder install-app-deps",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "e2e": "playwright test",
    "test:e2e": "npm run build && playwright test",
    "harness:server": "node --experimental-strip-types --import ./electron/server/harness-register.mjs electron/server/harness.ts",
    "harness:e2e": "node --experimental-strip-types --import ./electron/server/harness-register.mjs electron/server/e2e-harness.ts",
    "harness:pair": "node --experimental-strip-types --import ./electron/server/harness-register.mjs electron/server/pair-harness.ts",
    "harness:relay-bridge": "node --experimental-strip-types --import ./electron/server/harness-register.mjs electron/server/relay-bridge-harness.ts",
    "harness:webrtc": "node --experimental-strip-types --import ./electron/server/harness-register.mjs electron/server/webrtc-host-harness.ts",
    "harness:search": "node --experimental-strip-types --import ./electron/server/harness-register.mjs electron/search-core.harness.ts",
    "harness:ssh-config": "node --experimental-strip-types electron/ssh/config-discovery.harness.ts",
    "harness:patch-match": "node --experimental-strip-types electron/patch-match.harness.ts",
    "harness:worktree": "node --experimental-strip-types --import ./electron/agent/mcp-harness-register.mjs electron/git-worktree.harness.ts",
    "harness:worktree-iso": "node --experimental-strip-types --import ./electron/agent/mcp-harness-register.mjs electron/worktree-isolation.harness.ts",
    "harness:automations": "node --experimental-strip-types --import ./electron/agent/mcp-harness-register.mjs electron/automations/automations.harness.ts",
    "harness:mcp": "node --experimental-strip-types --import ./electron/agent/mcp-harness-register.mjs electron/agent/mcp-harness.ts",
    "harness:prompt-injection": "node --experimental-strip-types --import ./electron/agent/mcp-harness-register.mjs electron/agent/prompt-injection-harness.ts",
    "harness:agent-attachments": "node --experimental-strip-types electron/agent/attachment-harness.ts",
    "harness:dev-reload": "node --experimental-strip-types electron/dev-reload-harness.ts",
    "harness:xai-vision": "node --experimental-strip-types --import ./electron/agent/mcp-harness-register.mjs electron/agent/xai-vision-harness.ts",
    "harness:image-gen": "node --experimental-strip-types electron/agent/image-generation-harness.ts",
    "harness:media-gen": "node --experimental-strip-types electron/agent/image-generation-harness.ts",
    "harness:plugins": "node --experimental-strip-types --import ./electron/agent/mcp-harness-register.mjs electron/plugins/plugin-harness.ts",
    "harness:browser-menu": "node --experimental-strip-types electron/browser/native-menu-harness.ts",
    "harness:subagent": "node --experimental-strip-types --import ./electron/agent/mcp-harness-register.mjs electron/agent/subagent-harness.ts",
    "harness:background": "node --experimental-strip-types --import ./electron/agent/mcp-harness-register.mjs electron/agent/background-harness.ts",
    "harness:plan": "node --experimental-strip-types --import ./electron/agent/mcp-harness-register.mjs electron/agent/plan-harness.ts",
    "harness:threads": "node --experimental-strip-types --import ./electron/agent/mcp-harness-register.mjs electron/agent/thread-registry.harness.ts",
    "harness:agent-turn-edits": "node --experimental-strip-types electron/agent/turn-edits-harness.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "build": {
    "appId": "com.marudesk.app",
    "productName": "marudesk",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Liruns",
        "repo": "marudesk"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "synopsis": "Code-aware desktop agent with a browser stage, editor, and terminal.",
      "maintainer": "Liruns <duct1235@gmail.com>"
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/openai": "^3.0.67",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@ai-sdk/provider-utils": "^4.0.27",
    "@ai-sdk/xai": "^3.0.93",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@pierre/diffs": "^1.2.7",
    "@pierre/trees": "^1.0.0-beta.4",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.193",
    "dompurify": "^3.4.7",
    "electron-updater": "^6.3.9",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.16.0",
    "marked": "^15.0.12",
    "marked-highlight": "^2.2.4",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "ssh2": "^1.17.0",
    "werift": "^0.23.0",
    "ws": "^8.21.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tslib": "^2.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^0.29.1",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.7"
    }
  }
}
