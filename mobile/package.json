{
  "name": "marudesk-mobile",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "marudesk Model-B bridge — mobile (Capacitor) thin client for the PC's AI Chat. Sends agent commands and renders the PC's agent state over a relay; never runs the model/tools itself.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "smoke": "npm run smoke:stub && npm run smoke:storage && npm run smoke:pairing && npm run smoke:relay && npm run smoke:notifications",
    "smoke:stub": "node --experimental-strip-types --import ./scripts/ts-register.mjs scripts/stub-smoke.ts",
    "smoke:storage": "node --experimental-strip-types --import ./scripts/ts-register.mjs scripts/storage-smoke.ts",
    "smoke:pairing": "node --experimental-strip-types --import ./scripts/ts-register.mjs scripts/pairing-smoke.ts",
    "smoke:relay": "node --experimental-strip-types --import ./scripts/ts-register.mjs scripts/relay-transport-smoke.ts",
    "smoke:notifications": "node --experimental-strip-types --import ./scripts/ts-register.mjs scripts/notifications-smoke.ts",
    "cap:sync": "cap sync android",
    "cap:add:android": "cap add android",
    "android:build": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.1",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/network": "^6.0.3",
    "@capacitor/preferences": "^6.0.3",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
