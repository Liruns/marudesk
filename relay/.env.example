# marudesk-relay configuration (Bridge Model B, B1).
# Copy to .env for local dev. For dev you can leave EVERYTHING unset:
#   - JWT_SECRET auto-generates an EPHEMERAL secret at boot (logs a warning).
#   - OAuth stays "not configured" and those endpoints return 503 (the rest works).

# TCP port the relay listens on. Default 8788.
PORT=8788

# Bind address. A real deployment binds 0.0.0.0 (reachable). Dev = localhost.
# Default 0.0.0.0; set 127.0.0.1 to keep it strictly local.
HOST=0.0.0.0

# HS256 signing secret for our JWTs. REQUIRED in production. If unset, the relay
# generates a random ephemeral secret per boot (all tokens invalidate on restart)
# and logs a clear warning.
JWT_SECRET=

# Token lifetimes (seconds). Defaults: access ~15m, refresh ~30d.
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000

# Per-IP rate limit on the auth endpoints (signup/login/refresh/oauth). Token
# bucket: AUTH_RATE_BURST is the burst size, AUTH_RATE_REFILL_PER_SEC the steady
# rate. Defaults: burst 10, refill 0.5/sec.
AUTH_RATE_BURST=10
AUTH_RATE_REFILL_PER_SEC=0.5

# Where the file-backed AccountStore writes its JSON (dev only; swap a real DB
# for production). Default: ./relay-data/accounts.json relative to cwd.
DATA_DIR=relay-data

# Comma-separated allowed CORS origins for the HTTP auth API. localhost variants
# are always allowed for dev; add your web client / app origins here for prod.
# Example: https://app.example.com,https://relay.example.com
CORS_ORIGINS=

# ── OAuth web apps (optional). If a provider's id/secret are unset, that
# provider's endpoints return 503 "OAuth not configured" — the service still runs.
# The redirect URI sent to the provider is OAUTH_REDIRECT_BASE + /auth/<p>/callback.
OAUTH_REDIRECT_BASE=http://localhost:8788

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
