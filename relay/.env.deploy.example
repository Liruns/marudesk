# Production deployment env for docker-compose. Copy to `.env` (next to
# docker-compose.yml) and fill in. Compose reads it for both ${RELAY_DOMAIN}
# substitution (Caddy) and the relay container's env_file.

# The public domain that resolves to this server (A/AAAA record). Caddy obtains a
# Let's Encrypt cert for it automatically; clients connect to wss://$RELAY_DOMAIN.
RELAY_DOMAIN=relay.example.com

# REQUIRED: HS256 JWT signing secret, >= 32 bytes of entropy. Generate ONCE and
# keep it stable (changing it invalidates everyone's tokens):
#   openssl rand -hex 48
JWT_SECRET=

# Allowed WebSocket Origins. The Electron PC host sends NO Origin (native) and
# always connects. The phone's WebView sends one:
#   - Android Capacitor → http(s)://localhost  (already allowed, no entry needed)
#   - iOS WKWebView     → capacitor://localhost (add it here)
# Comma-separated; add any web origins too.
CORS_ORIGINS=capacitor://localhost

# Base URL for OAuth redirects — only needed if you enable Google/GitHub login.
# Must be your public https URL so the provider redirects back through Caddy.
OAUTH_REDIRECT_BASE=https://relay.example.com

# ── Optional OAuth apps. Leave unset to keep /auth/{google,github} at 503. ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
