{
  "name": "marudesk-relay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Cloud relay + auth backend for marudesk (Bridge Model B). Payload-agnostic dumb pipe brokering same-account host<->client WS, plus account/JWT/OAuth.",
