    "harness": "node --experimental-strip-types test/harness.ts"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/ws": "^8.5.13",
    "typescript": "~6.0.2"
  }
}
